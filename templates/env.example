# === 分镜 LLM ===
ANTHROPIC_API_KEY=<optional>
CLAUDE_MODEL=claude-opus-4-7
# 国内默认可改为 doubao，并复用下方 ARK_API_KEY
DEFAULT_LLM_PROVIDER=doubao

# === Seedance 2.5 + 视频理解质检（必填）===
ARK_API_KEY=<required>
ARK_REGION=cn-beijing
ARK_VIDEO_PRIMARY_MODEL=doubao-seedance-2-5-260628
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
ARK_VIDEO_RESOLUTION=720p
VIDEO_QA_ENABLED=true
SEEDANCE25_LONG_SCENE_ENABLED=true

# === Seedance 付费重试保护 ===
# 0=不自动重试；1=硬缺陷最多自动整镜重生一次。纯 visual_mismatch 不自动重试。
SEEDANCE_MAX_AUTO_RETRIES=1
# 单次自动重试的预计费用上限（分）；默认 800 分=¥8，0=不限制。
SEEDANCE_AUTO_RETRY_BUDGET_CENTS=800
# 标准版单个 job 的 Seedance 硬预算（分）；默认 2500 分=¥25，0=不限制。
SEEDANCE_JOB_BUDGET_CENTS=2500

# === 豆包录音文件识别 2.0（字幕校准/本地媒体转写）===
# 新版控制台优先：开通“录音文件识别2.0”后，在 API Key 页面创建 App Key。
VOLC_ASR_API_KEY=<required>

# === TOS 公网视频地址（必填，供视频质检和连续镜头参考）===
VOLC_AK=<required>
VOLC_SK=<required>
# 真人资产自动发现（只读；复用 VOLC_AK / VOLC_SK）
VOLC_ASSETS_ENDPOINT=open.volcengineapi.com
VOLC_ASSETS_REGION=cn-beijing
VOLC_ASSETS_PROJECT=default
TOS_BUCKET=<required>
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_OBJECT_PREFIX=ai-video-factory

# === BGM（选填，不填默认走静音兜底）===
SUNO_API_KEY=<optional>
DEFAULT_MUSIC_PROVIDER=silent

# === 调度（首测用 1+1，稳定后再加大）===
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_SHOTS=1
# 调度器步骤重试次数；与上方 Seedance 付费镜头重试保护相互独立。
MAX_RETRIES=2

# === 发布模式 ===
# manual: 不发布，登记路径让人工审核（推荐）
# playwright: 走 RPA 自动发布（需自行实装 s7_publish._via_playwright）
PUBLISH_MODE=manual

# === Douyin OpenAPI direct publishing (optional) ===
# Obtain these two values from the Douyin Open Platform application page.
DOUYIN_CLIENT_KEY=<optional>
DOUYIN_CLIENT_SECRET=<optional>
# Registered HTTPS callback URL ending in:
# /api/integrations/douyin/oauth/callback
DOUYIN_REDIRECT_URI=<optional>

# === WeChat Channels official assistant (optional override) ===
# The management console already uses this official page by default.
WEIXIN_CHANNELS_ASSISTANT_URL=https://channels.weixin.qq.com/login

# === 品牌（选填；留空则不添加品牌文字）===
BRAND_NAME=
