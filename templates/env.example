# === Anthropic Claude(必填,跑分镜/合规/打分) ===
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# === 火山方舟(必填,跑即梦视频 + 豆包 TTS) ===
ARK_API_KEY=
ARK_REGION=cn-beijing
ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
ARK_IMAGE_MODEL=doubao-seedream-3-0-t2i

# === 豆包 TTS(必填) ===
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_TTS_VOICE=zh_female_qingxin

# === 可灵(选填,备用 video provider) ===
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# === Suno BGM(选填,不填默认走静音兜底) ===
SUNO_API_KEY=

# === Provider 默认值 ===
DEFAULT_VIDEO_PROVIDER=seedance
DEFAULT_TTS_PROVIDER=doubao
# silent = ffmpeg 生成静音(首测用,零依赖) / suno / haimian / library
DEFAULT_MUSIC_PROVIDER=silent

# === 调度(首测用 1+1,稳了再加大) ===
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_SHOTS=1
MAX_RETRIES=2

# === 发布模式 ===
# manual: 不发布,登记路径让人工审(推荐)
# playwright: 走 RPA 自动发布(需自行实装 s7_publish._via_playwright)
PUBLISH_MODE=manual
